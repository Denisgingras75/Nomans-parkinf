# Shared secret you set in the Bouncie Developer Portal webhook config.
# The /api/bouncie/webhook route rejects anything that doesn't match.
BOUNCIE_WEBHOOK_SECRET=change-me

# Password gate for /driver. Anyone with this can act as the driver.
DRIVER_PASSCODE=change-me

# Optional: which Bouncie VIN/IMEI identifies the shuttle. Other vehicles
# in the same Bouncie account will be ignored.
SHUTTLE_VEHICLE_ID=
