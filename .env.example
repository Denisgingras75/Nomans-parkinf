# Admin gate. /admin requires this passcode to unlock. Set it in Vercel
# (Settings → Environment Variables) — the only env var the owner has
# to touch by hand. From there everything else (drivers, NoMans pin,
# service area, capacity, online toggle) is editable in the UI.
ADMIN_PASSCODE=change-me

# Shared secret you set in the Bouncie Developer Portal webhook config.
# The /api/bouncie/webhook route rejects anything that doesn't match.
BOUNCIE_WEBHOOK_SECRET=change-me

# OPTIONAL — legacy single-passcode driver login. Useful as a bootstrap
# before you add per-driver codes in /admin, or as a "skeleton key" if
# someone loses their driver code. Leave blank to require admin-issued
# driver codes only.
DRIVER_PASSCODE=

# OPTIONAL — Bouncie VIN/IMEI of the combi. Other vehicles in the same
# Bouncie account will be ignored.
SHUTTLE_VEHICLE_ID=

# OPTIONAL — Twilio SMS for driver alerts. When all three are set,
# every new pickup ping texts every on-shift driver who has a phone
# number on file. Skip them and the rest of the app still works,
# alerts just stay disabled. Get a Twilio number at twilio.com.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_FROM=+15085551234

# OPTIONAL — Vercel KV / Upstash Redis. When these are set the queue,
# drivers list, and settings survive serverless cold starts. Without
# them everything falls back to in-process memory (fine for `npm run
# dev`, lossy on Vercel). Add the "Upstash Redis" integration from
# Vercel Marketplace and these get set automatically.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
